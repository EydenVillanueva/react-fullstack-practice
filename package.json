{
  "name": "react-fullstack-practice",
  "version": "1.0.0",
  "private": true,
  "description": "Practice workspace for React + Node/Express + SQL + JS algorithms, graded with automated tests (HackerRank-style).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"node --watch server/index.js\"",
    "web": "vite",
    "api": "node --watch server/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:algo": "vitest run algorithms",
    "test:react": "vitest run src/react",
    "test:api": "vitest run server",
    "test:sql": "vitest run sql"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "jsdom": "^26.1.0",
    "supertest": "^7.3.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  }
}
